# ─── JobTracker AI — Backend Environment Variables ───────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

# Server
PORT=5000
NODE_ENV=development          # Change to: production (on Render)

# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=JobTracker

# JWT Secret — must be at least 32 random characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars

# CORS — which frontend URL is allowed to call this API
# Development:  http://localhost:3000
# Production:   your Vercel URL, e.g. https://job-tracker-xyz.vercel.app
FRONTEND_URL=http://localhost:3000

# Hugging Face Inference API (free tier)
# Get your key at: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_key_here

# Pinecone vector database (free tier)
# Create an index named job-tracker with dimension=384, metric=cosine
# Get your key at: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=job-tracker
